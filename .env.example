# بسم الله الرحمن الرحيم
# Every variable the dev environment knows — names and provenance only, NEVER values.
# The truth lives in secrets/dev.enc.yaml (SOPS + age, ADR-0019). Generate a local .env:
#   sops -d --output-type dotenv secrets/dev.enc.yaml > .env
# ADR-0020: repos are PUBLIC — no credential is committed even encrypted; the SOPS file
# is deferred until a private home or the first real CI secret. Values live only in
# gitignored .env files until then.
# Load in dev with Node's native flag:   node --env-file=.env ...
# CI decrypts the same file with its single AGE_KEY secret. One credential per consumer:
# the agent's PAT is never mirrored into CI — Actions uses its built-in GITHUB_TOKEN.

# Postgres for tests/dev (CI provides a service container) — not a secret, an address
PG_URL=postgres://postgres:kb@127.0.0.1:5432/kbtest

# Agent push access — fine-grained PAT, kb + kb-deploy only, 90-day expiry (ADR-0018)
GITHUB_PAT=

# Model gateway (stage 5+); also the nightly live-smoke credential
ANTHROPIC_API_KEY=

# Throwaway boxes for real-box install CI (stages 1 & 9)
HETZNER_API_TOKEN=

# Backups + restore drills → Cloudflare R2 (stage 1)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
